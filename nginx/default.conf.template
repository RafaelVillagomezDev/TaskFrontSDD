# Servidor de la SPA (plan §3). ${VITE_API_URL} se sustituye al arrancar el contenedor
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # CSP: solo recursos propios; la app solo habla con TaskApiSDD
    set $api_origin "${VITE_API_URL}";

    # Ficheros con hash en el nombre: caché larga
    location /assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # Rutas de la SPA: siempre index.html, sin caché para que un despliegue se vea al recargar
    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ /index.html;
    }
}
