# Imagen de producción (plan §3): build con Vite y Nginx sin root sirviendo dist/

# --- Etapa 1: build ---
FROM node:22-alpine AS build

ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable

WORKDIR /app

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY . .

# Vite incrusta VITE_API_URL en el bundle al compilar: cambiarla exige reconstruir la imagen
ARG VITE_API_URL
RUN test -n "$VITE_API_URL" || (echo "Falta el build arg VITE_API_URL" >&2 && exit 1)
ENV VITE_API_URL=$VITE_API_URL
RUN pnpm build

# --- Etapa 2: runtime ---
FROM nginxinc/nginx-unprivileged:1.30-alpine

# Entorno del servidor web (spec 004 RF-18, plan D-5): pre (HTTP, para probar la imagen) o pro (detrás del proxy de
# Dokploy, siempre HTTPS). Un valor no válido falla al construir, no al arrancar
ARG NGINX_ENV

# La plantilla elegida se resuelve al arrancar con VITE_API_URL del entorno (CSP: connect-src a la API). Se copian
# las dos y se elige en un RUN para que un NGINX_ENV que falta o no es válido dé un mensaje claro. La imagen corre
# como el usuario 101: la copia necesita root y se vuelve a 101 después
COPY nginx/pre.conf.template nginx/pro.conf.template /tmp/nginx-templates/
USER root
RUN case "$NGINX_ENV" in pre|pro) ;; *) echo "NGINX_ENV debe ser pre o pro (recibido: '$NGINX_ENV')" >&2 && exit 1 ;; esac \
    && mkdir -p /etc/nginx/templates \
    && cp "/tmp/nginx-templates/$NGINX_ENV.conf.template" /etc/nginx/templates/default.conf.template \
    && rm -rf /tmp/nginx-templates
USER 101
# Cabeceras de seguridad y proxy inverso: IP real, límites por IP, métodos, rutas de escáneres, tiempos y registro
COPY nginx/security-headers.conf nginx/http-hardening.conf nginx/server-hardening.conf /etc/nginx/snippets/
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 8080
