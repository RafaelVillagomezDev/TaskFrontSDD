{
  // Solo para el análisis de SonarQube: su TypeScript integrado no reconoce erasableSyntaxOnly.
  // Mismas opciones que tsconfig.app.json salvo esa; el tipado real lo comprueba `pnpm typecheck`
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client", "jest", "@testing-library/jest-dom"],
    // Alias de importación (AGENTS.md §4): @modules/x solo resuelve al index.ts público del módulo
    "paths": {
      "@shared/*": ["./src/shared/*"],
      "@modules/*": ["./src/modules/*/index.ts"],
      "@test-utils/*": ["./jest/*"]
    }
  },
  "include": ["src", "jest"]
}
