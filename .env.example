# Copiar a .env.dev y .env.prod (nunca se versionan) y rellenar los valores. Ver README.md, «Variables de entorno».

# URL de TaskApiSDD. Se incrusta en el bundle en tiempo de build: nunca un secreto
VITE_API_URL=

# Puerto del host donde se publica Nginx (solo producción)
WEB_HOST_PORT=

# Usuario de prueba dedicado de las E2E (solo desarrollo)
E2E_USER_EMAIL=
E2E_USER_PASSWORD=

# SonarQube (solo desarrollo)
SONAR_ADMIN_PASSWORD=
SONAR_TOKEN=
