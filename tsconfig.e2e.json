{
  // Pruebas E2E de Playwright: se ejecutan en Node, con las mismas reglas estrictas que la app
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM"],
    // Las E2E reutilizan utilidades de la app (fechas) con el mismo alias que src/
    "paths": {
      "@shared/*": ["./src/shared/*"]
    }
  },
  "include": ["e2e"]
}
