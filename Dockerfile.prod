# Imagen de producción (plan §3): build con Vite y Nginx sin root sirviendo dist/

# --- Etapa 1: build ---
FROM node:22-alpine AS build

ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable

WORKDIR /app

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY . .

# Vite incrusta VITE_API_URL en el bundle al compilar: cambiarla exige reconstruir la imagen
ARG VITE_API_URL
RUN test -n "$VITE_API_URL" || (echo "Falta el build arg VITE_API_URL" >&2 && exit 1)
ENV VITE_API_URL=$VITE_API_URL
RUN pnpm build

# --- Etapa 2: runtime ---
FROM nginxinc/nginx-unprivileged:1.30-alpine

# La plantilla se resuelve al arrancar con VITE_API_URL del entorno (CSP: connect-src a la API)
COPY nginx/default.conf.template /etc/nginx/templates/default.conf.template
COPY nginx/security-headers.conf /etc/nginx/snippets/security-headers.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 8080
