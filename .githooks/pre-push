#!/bin/sh
# Antes de cada push: tests con cobertura, E2E de Chromium en los tres tamaños y quality gate de SonarQube
# (CONSTITUTION.md IV.6). Activar una vez por clon: git config core.hooksPath .githooks.
# Saltárselo con --no-verify está prohibido.

SONAR_URL=http://localhost:9001
API_URL=http://localhost:3000
ZERO=0000000000000000000000000000000000000000
DC="docker compose -f docker-compose.dev.yml"

fail() {
  {
    echo "✖ $1"
    echo "  Push rechazado (CONSTITUTION.md IV.6)."
  } >&2
  exit 1
}

# 1. Lo que se analiza (el árbol de trabajo) tiene que ser exactamente lo que se sube.
#    De paso se reúnen los ficheros que cambian en el push para saber si solo son .md
head=$(git rev-parse HEAD)
changed=""
while read -r _local_ref local_sha _remote_ref remote_sha; do
  # Borrar una rama remota no sube código
  [ "$local_sha" = "$ZERO" ] && continue
  [ "$local_sha" = "$head" ] || fail "Solo se puede subir la rama en la que estás (HEAD): el análisis se hace sobre el árbol de trabajo."
  if [ "$remote_sha" = "$ZERO" ]; then
    # Rama nueva: se compara con main, o se considera todo si main no existe
    base=$(git merge-base "$local_sha" origin/main 2>/dev/null || git rev-list --max-parents=0 "$local_sha" | tail -1)
  else
    base=$remote_sha
  fi
  changed="$changed
$(git diff --name-only "$base" "$local_sha")"
done
if [ -n "$(git status --porcelain -- src e2e jest nginx package.json pnpm-lock.yaml '*.config.ts' 'tsconfig*.json' eslint.config.js sonar-project.properties)" ]; then
  fail "Hay cambios sin commitear en el código: haz commit o guárdalos con git stash para que el análisis corresponda a lo que subes."
fi
only_md=true
for f in $changed; do
  case "$f" in
    *.md | *.MD) ;;
    *) only_md=false ;;
  esac
done

# 2. SonarQube levantado
curl -fsS "$SONAR_URL/api/system/status" 2>/dev/null | grep -q '"status":"UP"' ||
  fail "SonarQube no está levantado: docker compose -f docker-compose.sonar.yml up -d sonarqube"

# 3. Tests con cobertura (genera coverage/lcov.info para el análisis)
echo "▶ Tests con cobertura..."
$DC exec -T web pnpm test:coverage < /dev/null ||
  fail "Los tests no pasan o el contenedor web no está levantado ($DC up -d)."

# 4. E2E de Chromium en móvil, tablet y escritorio, salvo si el push solo cambia ficheros .md (IV.6, excepción)
if [ "$only_md" = true ]; then
  echo "▶ Solo cambian ficheros .md: se omiten las E2E"
else
  curl -fsS -o /dev/null "$API_URL/auth/csrf" 2>/dev/null ||
    fail "TaskApiSDD no responde en $API_URL: levántala desde su repositorio."
  echo "▶ E2E de Chromium (móvil, tablet y escritorio)..."
  $DC run --rm -T e2e pnpm test:e2e --project=chromium-mobile --project=chromium-tablet --project=chromium-desktop < /dev/null ||
    fail "Las E2E de Chromium no pasan."
fi

# 5. Análisis en el proyecto de la rama actual: espera al quality gate y termina con error si no pasa
echo "▶ Análisis de SonarQube..."
if ! ./scripts/sonar-scan.sh < /dev/null; then
  # Detalle de lo que falla (condiciones, incidencias y hotspots con fichero y línea) para corregirlo en el código
  ./scripts/sonar-issues.sh < /dev/null || echo "  (no se pudo obtener el detalle: ./scripts/sonar-issues.sh)" >&2
  fail "El quality gate no pasa: corrige las incidencias de arriba (proyecto de esta rama en $SONAR_URL/projects)"
fi

echo "✔ Tests, E2E y quality gate en verde"
